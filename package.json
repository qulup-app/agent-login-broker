{
  "name": "agent-login-broker",
  "version": "0.1.1",
  "description": "MCP server that logs an AI agent into websites with your Bitwarden credentials, built to keep them away from the agent",
  "license": "MIT",
  "author": "qulup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qulup-app/agent-login-broker.git"
  },
  "keywords": [
    "mcp",
    "bitwarden",
    "login",
    "ai-agent",
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "agent-login-broker": "server.mjs"
  },
  "files": [
    "server.mjs",
    "plugin/skills",
    "pi",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./pi/extension.mjs"
    ],
    "skills": [
      "./plugin/skills"
    ]
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright": "^1.56.0",
    "tldts": "^7.4.19",
    "zod": "^3.25.0"
  }
}
